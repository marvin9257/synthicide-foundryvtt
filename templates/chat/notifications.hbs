<div id="chat-notifications" class="faded-ui flexcol">
    <div class="overflow">
        <!-- FIXED: Removed hardcoded theme-light so it inherits global dark/light cascades natively -->
        <ol class="chat-log plain themed"></ol>
    </div>
</div>

<prose-mirror id="chat-message" class="chat-input" name="message" aria-label="{{localize "CHAT.Chat"}}"
              style="--chat-message-placeholder: '{{localize "CHAT.EnterMessage"}}';"></prose-mirror>

<div id="chat-controls">
    <div id="message-modes" class="split-button">
        {{#each messageModes as |mode|}}
        <button type="button" class="ui-control icon {{mode.icon}}" data-action="messageMode"
                data-mode="{{mode.action}}" aria-pressed="{{mode.active}}"
                data-tooltip aria-label="{{localize mode.label}}"></button>
        {{/each}}
    </div>

    {{!-- Control Buttons --}}
    {{#if user.isGM}}
    <div class="control-buttons">
        <button type="button" class="ui-control icon fa-solid fa-floppy-disk" data-tooltip
                aria-label="{{ localize "CHAT.Export" }}" data-action="export"></button>
        <button type="button" class="ui-control icon fa-solid fa-trash" data-tooltip
                aria-label="{{ localize "CHAT.Clear" }}" data-action="flush"></button>
    </div>
    {{/if}}
</div>
