{{! Gear Tab }}
<section class='tab gear scrollable {{tab.cssClass}}' data-group='primary' data-tab='gear'>
  <h4>{{localize 'TYPES.Item.gear'}}</h4>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'Name'}}</div>
      <div class='item-formula'>{{localize 'SYNTHICIDE.Item.Gear.FIELDS.rollFormula.label'}}</div>
      <div class='item-controls'>
        {{#if @root.editable}}
          <a
            class='item-control item-create'
            data-tooltip='{{localize "DOCUMENT.Create" type='Item'}}'
            data-action='createDoc'
            data-document-class='Item'
            data-type='gear'
          >
            <i class='fas fa-plus'></i>
            {{localize 'DOCUMENT.New' type='item'}}
          </a>
        {{/if}}
      </div>
    </li>
    {{#each gear as |item id|}}
      <li
        class='item flexrow draggable'
        data-item-id='{{item._id}}'
        data-document-class='Item'
      >
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action='roll'>
              <img
                src='{{item.img}}'
                data-tooltip='{{localize "SYNTHICIDE.Roll.Tooltip.RollWithItem" item=item.name}}'
              />
            </a>
          </div>
          <div class='item-label'>{{item.name}}</div>
        </div>
        <div class='item-formula item-prop'>
          {{#if item.system.roll.enabled}}
            {{item.system.formula}}
          {{else}}
            {{localize 'SYNTHICIDE.Item.Gear.FIELDS.rollDisabled'}}
          {{/if}}
        </div>
        <div class='item-controls'>
          {{#if @root.editable}}
            <a
              class='item-control item-edit'
              data-tooltip='{{localize "DOCUMENT.Update" type='Gear'}}'
              data-action='viewDoc'
            >
              <i class='fas fa-edit'></i>
            </a>
          
            <a
              class='item-control item-delete'
              data-tooltip='{{localize "DOCUMENT.Delete" type='Gear'}}'
              data-action='deleteDoc'
            >
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>

  <h4>{{localize 'SYNTHICIDE.Actor.Gear.Artifacts'}}</h4>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'Name'}}</div>
      <div class='item-prop'>{{localize 'SYNTHICIDE.Item.Artifact.FIELDS.Level'}}</div>
      <div class='item-formula'>{{localize 'SYNTHICIDE.Item.Gear.FIELDS.rollFormula.label'}}</div>
      <div class='item-controls'>
        {{#if @root.editable}}
          <a
            class='item-control item-create'
            data-tooltip='{{localize "DOCUMENT.Create" type='Item'}}'
            data-action='createDoc'
            data-document-class='Item'
            data-type='artifact'
          >
            <i class='fas fa-plus'></i>
            {{localize 'DOCUMENT.New' type='item'}}
          </a>
        {{/if}}
      </div>
    </li>
    {{#each artifacts as |item id|}}
      <li
        class='item flexrow draggable'
        data-item-id='{{item._id}}'
        data-document-class='Item'
      >
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action='roll'>
              <img
                src='{{item.img}}'
                data-tooltip='{{localize "SYNTHICIDE.Roll.Tooltip.RollWithItem" item=item.name}}'
              />
            </a>
          </div>
          <div class='item-label'>{{item.name}}</div>
        </div>
        <div class='item-prop'>{{#if item.system.level}}{{item.system.level}}{{else}}-{{/if}}</div>
        <div class='item-formula item-prop'>
          {{#if item.system.roll.enabled}}
            {{item.system.formula}}
          {{else}}
            {{localize 'SYNTHICIDE.Item.Gear.FIELDS.rollDisabled'}}
          {{/if}}
        </div>
        <div class='item-controls'>
          {{#if @root.editable}}
            <a
              class='item-control item-edit'
              data-tooltip='{{localize "DOCUMENT.Update" type='Artifact'}}'
              data-action='viewDoc'
            >
              <i class='fas fa-edit'></i>
            </a>

            <a
              class='item-control item-delete'
              data-tooltip='{{localize "DOCUMENT.Delete" type='Artifact'}}'
              data-action='deleteDoc'
            >
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>

</section>