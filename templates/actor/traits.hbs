{{! Traits Tab – leveled traits section (replaces former spells implementation) }}
<section
  class='tab traits scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='traits'
>
  <ol class='items-list'>
    {{#each traitsByLevel as |entry|}}
      <li class='item flexrow items-header'>
        <div class='item-name'>
          {{localize 'SYNTHICIDE.Item.Trait.TraitLVL' level=entry.level}}
        </div>
        <div class='item-controls'>
          {{#if @root.editable}}
            <a
              class='item-control item-create'
              data-tooltip='{{localize "DOCUMENT.Create" type=(localize "SYNTHICIDE.Item.Trait.TypeLabel")}}'
              data-action='createDoc'
              data-document-class='Item'
              data-type='trait'
              data-system.level='{{entry.level}}'
              data-system.trait-type='generalTalent'
            >
              <i class='fas fa-plus'></i>
              {{localize 'SYNTHICIDE.Item.Trait.AddLVL' level=entry.level}}
            </a>
          {{/if}}
        </div>
      </li>
      {{#each entry.traits as |item id|}}
        <li
          class='item flexrow draggable'
          data-item-id='{{item._id}}'
          data-document-class='Item'
        >
          <div class='item-name flexrow'>
            <div class='item-image'>
              <a class='rollable' data-roll-type='item' data-action='roll'>
                <img
                  src='{{item.img}}'
                  data-tooltip='{{localize "SYNTHICIDE.Roll.Tooltip.DescribeItem" item=item.name}}'
                />
              </a>
            </div>
            
            <!-- Unified CSS Layout block replaces style string variables -->
            <div class='item-label-container'>
              <div class='item-label'>{{item.name}}</div>
              
              {{#if item.system.powerCountersList}}
                <ul class='power-uses-tracking'>
                  <li class='flexrow power-header-row'>
                    <span class='power-name-header'>{{localize "SYNTHICIDE.Item.Trait.PowerHeader"}}</span>
                    <span class='power-uses-header'>{{localize "SYNTHICIDE.Item.Trait.UsesHeader"}}</span>
                  </li>
                  {{#each item.system.powerCountersList as |power|}}
                    <li class='flexrow power-row'>
                      <!-- Left Aligned Power Name Title -->
                      <span class='power-name'>
                        <i class='fas fa-bolt'></i>{{power.label}}
                      </span>
                      
                      <!-- Right Aligned Harmonized Stepper Layout Framework -->
                      <div class='resource-content flexrow flex-center flex-between resource-counter'>
                        <div class='resource-stepper' data-counter-key='powerUse'>
                          
                          <!-- Reused Core Subtraction Control Component Button -->
                          <button type='button' 
                                  class='resource-step-btn' 
                                  data-action='decreaseCounter' 
                                  data-counter-key='powerUse' 
                                  data-item-id='{{item._id}}' 
                                  data-power-key='{{power.key}}' 
                                  aria-label='Decrease {{power.label}}'>-</button>
                                  
                          <!-- Reused Standard Counter Display Slot -->
                          <span class='counter-value'>{{power.count}}</span>
                          
                          <!-- Reused Core Addition Control Component Button -->
                          <button type='button' 
                                  class='resource-step-btn' 
                                  data-action='increaseCounter' 
                                  data-counter-key='powerUse' 
                                  data-item-id='{{item._id}}' 
                                  data-power-key='{{power.key}}' 
                                  aria-label='Increase {{power.label}}'>+</button>
                                  
                        </div>
                      </div>
                    </li>
                  {{/each}}
                </ul>
              {{/if}}
            </div>
          </div>

          <div class='item-controls'>
            <a
              class='item-control item-edit'
              data-tooltip='{{localize "DOCUMENT.Update" type=(localize "SYNTHICIDE.Item.Trait.TypeLabel")}}'
              data-action='viewDoc'
            >
              <i class='fas fa-edit'></i>
            </a>
            {{#if @root.editable}}
              <a
                class='item-control item-delete'
                data-tooltip='{{localize "DOCUMENT.Delete" type=(localize "SYNTHICIDE.Item.Trait.TypeLabel")}}'
                data-action='deleteDoc'
              >
                <i class='fas fa-trash'></i>
              </a>
            {{/if}}
          </div>
        </li>
      {{/each}}
    {{/each}}
  </ol>

</section>
