{{! Attributes Tab }}
<section class="tab attributes scrollable {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  {{#if useLegacyAttributesLayout}}
    <div class='attributes-layout'>
      <div class='attributes-panel'>
        <table class="attributes-table" role="table" aria-label="Attributes">
          <colgroup>
            <col class="col-icon">
            <col class="col-base">
            <col class="col-modifier">
            <col class="col-increase">
            <col class="col-current">
          </colgroup>
          <thead>
            <tr>
              <th class="attributes-col-header" scope="col"></th>
              <th class="attributes-col-header" scope="col">{{localize 'SYNTHICIDE.Actor.Attributes.Base'}}</th>
              <th class="attributes-col-header" scope="col">{{localize 'SYNTHICIDE.Actor.Attributes.Modifier'}}</th>
              <th class="attributes-col-header" scope="col">{{localize 'SYNTHICIDE.Actor.Attributes.LevelIncrease'}}</th>
              <th class="attributes-col-header" scope="col">{{localize 'SYNTHICIDE.Actor.Attributes.Current'}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each system.attributes as |attribute key|}}
              <tr>
                <th class="attribute-label" scope="row">
                  <span class="attr-abbr" data-tooltip="{{localize (lookup @root.SYNTHICIDE.attributes key)}}">{{localize (lookup @root.SYNTHICIDE.attributeAbbreviations key)}}</span>
                  <span class="rollable" data-action="roll" data-roll-type="challenge" data-attribute-key="{{key}}" data-roll="d10+@attributes.{{key}}.value" data-label="{{localize (lookup @root.SYNTHICIDE.attributes key)}}" tabindex="0" role="button" data-tooltip="{{localize (lookup @root.SYNTHICIDE.attributes key)}}">
                    <img class="actions-img" src="{{concat '/systems/synthicide/assets/icons/attributes/' key '.png'}}" alt="">
                  </span>
                </th>
                <td class="attribute-input"><input type="text" name="system.attributes.{{key}}.base" value="{{numberFormat attribute.base decimals=0 sign=true}}" class="attribute-score" data-dtype="Number" max="5" step="1"></td>
                <td class="attribute-input"><input disabled type="text" name="system.attributes.{{key}}.displayModifier" value="{{numberFormat attribute.displayModifier decimals=0 sign=true}}" class="attribute-score" data-dtype="Number" step="1" data-tooltip="{{attribute.modifierTooltip}}"></td>
                <td class="attribute-input">
                  <div class="attribute-stepper" data-attribute-key="{{key}}">
                    <div class="attribute-block-meter-grid" aria-label="{{localize (lookup @root.SYNTHICIDE.attributes key)}} increase {{attribute.increase}} of 5">
                      {{#each attribute.increaseSegments}}<div class="segment{{#if this}} filled{{/if}}"></div>{{/each}}
                    </div>
                    <input type="text" name="system.attributes.{{key}}.increase" value="{{numberFormat attribute.increase decimals=0 sign=true}}" class="attribute-score" data-dtype="Number" min="0" max="5" step="1">
                    <div class="attribute-step-buttons">
                      <button type="button" class="attribute-step-btn" data-action="increaseAttribute" data-attribute-key="{{key}}" aria-label="Increase {{localize (lookup @root.SYNTHICIDE.attributes key)}}">+</button>
                      <button type="button" class="attribute-step-btn" data-action="decreaseAttribute" data-attribute-key="{{key}}" aria-label="Decrease {{localize (lookup @root.SYNTHICIDE.attributes key)}}">-</button>
                    </div>
                  </div>
                </td>
                <td class="attribute-value"><input disabled type="text" name="system.attributes.{{key}}.value" value="{{numberFormat attribute.value decimals=0 sign=true}}" class="attribute-score" data-dtype="Number" step="1"></td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class='attributes-derived'>
        <h4>{{localize "SYNTHICIDE.Actor.base.FIELDS.DerivedValues"}}</h4>
        <div class="derived-list">
          <div class='resource flex-group-center header-resource'><label class='resource-label'>{{localize 'SYNTHICIDE.Actor.base.FIELDS.actionPoints.value.label'}}</label><input type='number' name='system.actionPoints.value' value='{{system.actionPoints.value}}' data-dtype='Number' disabled></div>
          <div class='resource flex-group-center header-resource'><label class='resource-label'>{{localize 'SYNTHICIDE.Actor.base.FIELDS.battleReflex.value.label'}}</label><input type='number' name='system.battleReflex.value' value='{{system.battleReflex.value}}' data-dtype='Number' disabled></div>
          <div class='resource flex-group-center header-resource'><label class='resource-label'>{{localize 'SYNTHICIDE.Actor.base.FIELDS.toughnessDefense.value.label'}}</label><input type='number' name='system.toughnessDefense.value' value='{{system.toughnessDefense.value}}' data-dtype='Number' disabled></div>
          <div class='resource flex-group-center header-resource'><label class='resource-label'>{{localize 'SYNTHICIDE.Actor.base.FIELDS.armorDefense.value.label'}}</label><input type='number' name='system.armorDefense.value' value='{{system.armorDefense.value}}' data-dtype='Number' disabled></div>
          <div class='resource flex-group-center header-resource'><label class='resource-label'>{{localize 'SYNTHICIDE.Actor.base.FIELDS.shockThreshold.value.label'}}</label><input type='number' name='system.shockThreshold.value' value='{{system.shockThreshold.value}}' data-dtype='Number' disabled></div>
          <div class='resource flex-group-center header-resource'><label class='resource-label'>{{localize 'SYNTHICIDE.Actor.base.FIELDS.nerveDefense.value.label'}}</label><input type='number' name='system.nerveDefense.value' value='{{system.nerveDefense.value}}' data-dtype='Number' disabled></div>
        </div>
      </div>
    </div>
  {{else}}
  <div class="attributes-layout-modern">

    <!-- 1. LEFT PANEL: CARDS MATRIX -->
    <div class="attributes-panel-modern">
      {{#each system.attributes as |attribute key|}}
        <div class="attribute-card-hud">
          <div
            class="attr-roll-zone rollable"
            data-action="roll"
            data-roll-type="challenge"
            data-attribute-key="{{key}}"
            data-roll="d10+@attributes.{{key}}.value"
            data-label="{{localize (lookup @root.SYNTHICIDE.attributes key)}}"
            tabindex="0"
            role="button"
            data-tooltip="{{localize (lookup @root.SYNTHICIDE.attributes key)}}"
          >
            <div class="attr-identity-block">
              <span class="attr-abbr-tag" data-tooltip="{{localize (lookup @root.SYNTHICIDE.attributes key)}}">
                {{localize (lookup @root.SYNTHICIDE.attributeAbbreviations key)}}
              </span>
              <img class="actions-hud-img" src="{{concat '/systems/synthicide/assets/icons/attributes/' key '.png'}}" alt="">
            </div>
            <div class="attr-grand-total">
              <input disabled type="text" name="system.attributes.{{key}}.value" value="{{numberFormat attribute.value decimals=0 sign=true}}" class="attribute-score-display" data-dtype="Number">
            </div>
          </div>
          <details class="math-inspector-dropdown" data-attribute-key="{{key}}">
            <summary class="gear-toggle-btn" data-tooltip="{{attribute.modifierTooltip}}"><i class="fa-solid fa-gear"></i></summary>
            <div class="inspector-popup-panel">
              <h4 class="popup-panel-header">{{localize (lookup @root.SYNTHICIDE.attributes key)}} Math</h4>
              <div class="inspector-field-row">
                <label>{{localize 'SYNTHICIDE.Actor.Attributes.Base'}}</label>
                <input type="text" name="system.attributes.{{key}}.base" value="{{numberFormat attribute.base decimals=0 sign=true}}" class="attribute-popup-input" data-dtype="Number" max="5" step="1">
              </div>
              <div class="inspector-field-row">
                <label>{{localize 'SYNTHICIDE.Actor.Attributes.Modifier'}}</label>
                <input
                  disabled
                  type="text"
                  name="system.attributes.{{key}}.displayModifier"
                  value="{{numberFormat attribute.displayModifier decimals=0 sign=true}}"
                  class="attribute-popup-input disabled"
                  data-dtype="Number"
                  step="1"
                  data-tooltip="{{attribute.modifierTooltip}}"
                >
              </div>
              <div class="inspector-field-row level-row">
                <label>{{localize 'SYNTHICIDE.Actor.Attributes.LevelIncrease'}}</label>
                <div class="attribute-stepper-modern" data-attribute-key="{{key}}">
                  <div class="attribute-block-meter-grid" aria-label="{{localize (lookup @root.SYNTHICIDE.attributes key)}} increase {{attribute.increase}} of 5">
                    {{#each attribute.increaseSegments}}
                      <div class="segment{{#if this}} filled{{/if}}"></div>
                    {{/each}}
                  </div>
                  <input type="text" name="system.attributes.{{key}}.increase" value="{{numberFormat attribute.increase decimals=0 sign=true}}" class="attribute-popup-input hidden-stepper-value" data-dtype="Number" min="0" max="5" step="1">
                  <div class="attribute-step-buttons">
                    <button type="button" class="attribute-step-btn" data-action="increaseAttribute" data-attribute-key="{{key}}" aria-label="Increase {{localize (lookup @root.SYNTHICIDE.attributes key)}}">+</button>
                    <button type="button" class="attribute-step-btn" data-action="decreaseAttribute" data-attribute-key="{{key}}" aria-label="Decrease {{localize (lookup @root.SYNTHICIDE.attributes key)}}">-</button>
                  </div>
                </div>
              </div>
            </div>
          </details>
        </div>
      {{/each}}
    </div>

    <!-- 2. RIGHT PANEL: DERIVED VALUES BLOCK -->
    <div class="attributes-derived-modern">
      <h4 class="derived-section-title">{{localize "SYNTHICIDE.Actor.base.FIELDS.DerivedValues"}}</h4>
      <div class="derived-grid-layout">

        <div class="derived-resource-card">
          <label class="derived-label">{{localize 'SYNTHICIDE.Actor.base.FIELDS.actionPoints.value.label'}}</label>
          <input type="number" name="system.actionPoints.value" value="{{system.actionPoints.value}}" data-dtype="Number" disabled />
        </div>

        <div class="derived-resource-card">
          <label class="derived-label">{{localize 'SYNTHICIDE.Actor.base.FIELDS.battleReflex.value.label'}}</label>
          <input type="number" name="system.battleReflex.value" value="{{system.battleReflex.value}}" data-dtype="Number" disabled />
        </div>

        <div class="derived-resource-card">
          <label class="derived-label">{{localize 'SYNTHICIDE.Actor.base.FIELDS.toughnessDefense.value.label'}}</label>
          <input type="number" name="system.toughnessDefense.value" value="{{system.toughnessDefense.value}}" data-dtype="Number" disabled />
        </div>

        <div class="derived-resource-card">
          <label class="derived-label">{{localize 'SYNTHICIDE.Actor.base.FIELDS.armorDefense.value.label'}}</label>
          <input type="number" name="system.armorDefense.value" value="{{system.armorDefense.value}}" data-dtype="Number" disabled />
        </div>

        <div class="derived-resource-card">
          <label class="derived-label">{{localize 'SYNTHICIDE.Actor.base.FIELDS.shockThreshold.value.label'}}</label>
          <input type="number" name="system.shockThreshold.value" value="{{system.shockThreshold.value}}" data-dtype="Number" disabled />
        </div>

        <div class="derived-resource-card">
          <label class="derived-label">{{localize 'SYNTHICIDE.Actor.base.FIELDS.nerveDefense.value.label'}}</label>
          <input type="number" name="system.nerveDefense.value" value="{{system.nerveDefense.value}}" data-dtype="Number" disabled />
        </div>

      </div>
    </div>

  </div>
  {{/if}}
</section>
