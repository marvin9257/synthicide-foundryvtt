<div class='trait-top-fields trait-top-fields--artifact'>
  <div class='resource resource-pair'>
    <label class='resource-label'>{{localize 'SYNTHICIDE.Item.Artifact.FIELDS.Level'}}</label>
    <input
      type='number'
      name='system.level'
      value='{{system.level}}'
      min='1'
    />
  </div>
  <fieldset class = "artifact">
    <legend>
      {{#if system.uses.rechargeable}}
        {{localize 'SYNTHICIDE.Item.Artifact.FIELDS.Charges'}}
      {{else}}
        {{localize 'SYNTHICIDE.Item.Artifact.FIELDS.Uses'}}
      {{/if}}
    </legend>
    <div class='resource-content flexrow flex-center flex-between resource-counter'>
      <label>
        <input type='checkbox' name='system.uses.rechargeable' {{checked system.uses.rechargeable}} />
        {{localize 'SYNTHICIDE.Item.Artifact.FIELDS.Rechargeable'}}
      </label>
    </div>
    <div class='resource resource-pair'>
      <label class='resource-label'>{{localize 'SYNTHICIDE.Item.Artifact.FIELDS.Current'}}</label>
      <input
        type='number'
        name='system.uses.value'
        value='{{system.uses.value}}'
        min='0'
      />
    </div>
    <div class='resource resource-pair'>
      <label class='resource-label'>{{localize 'SYNTHICIDE.Item.Artifact.FIELDS.Max'}}</label>
      <input
        type='number'
        name='system.uses.max'
        value='{{system.uses.max}}'
        min='0'
      />
    </div>
  </fieldset>
  
</div>